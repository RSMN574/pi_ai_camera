#include <libcamera/libcamera.h>
#include <libcamera/formats.h>
#include <libcamera/framebuffer_allocator.h>

#include <opencv2/opencv.hpp>
#include "detector.hpp"

#include <sys/mman.h>

#include <iostream>
#include <memory>
#include <vector>
#include <mutex>
#include <condition_variable>
#include <chrono>

using namespace libcamera;

class CameraPreview
{
public:
    CameraPreview()
        : running_(true),
          frameReady_(false)
    {
    }

    int run()
    {
        std::cerr << "[DEBUG] Before YOLODetector" << std::endl;
        YOLODetector detector("models/yolov8n.onnx", 0.40f, 0.45f);
        std::cerr << "[DEBUG] YOLODetector created" << std::endl;

        int ret = cameraManager_.start();

        if (ret) {
            std::cerr << "CameraManager start failed: "
                      << ret << std::endl;
            return ret;
        }

        if (cameraManager_.cameras().empty()) {
            std::cerr << "No camera found" << std::endl;
            cameraManager_.stop();
            return -1;
        }

        camera_ = cameraManager_.cameras()[0];

        std::cout << "Using camera: "
                  << camera_->id() << std::endl;

        ret = camera_->acquire();

        if (ret) {
            std::cerr << "Camera acquire failed: "
                      << ret << std::endl;

            cameraManager_.stop();
            return ret;
        }

        /*
         * 建立 Viewfinder
         */
        config_ = camera_->generateConfiguration({
            StreamRole::Viewfinder
        });

        if (!config_) {
            std::cerr << "Failed to generate configuration"
                      << std::endl;

            cleanup();
            return -1;
        }

        streamConfig_ = &config_->at(0);

        streamConfig_->size = Size(640, 480);
        streamConfig_->pixelFormat = formats::RGB888;

        CameraConfiguration::Status validation =
            config_->validate();

        if (validation == CameraConfiguration::Invalid) {
            std::cerr << "Invalid camera configuration"
                      << std::endl;

            cleanup();
            return -1;
        }

        ret = camera_->configure(config_.get());

        if (ret) {
            std::cerr << "Camera configure failed: "
                      << ret << std::endl;

            cleanup();
            return ret;
        }

        stream_ = streamConfig_->stream();

        std::cout << "Resolution: "
                  << streamConfig_->size.width
                  << "x"
                  << streamConfig_->size.height
                  << std::endl;

        std::cout << "Format: "
                  << streamConfig_->pixelFormat.toString()
                  << std::endl;

        /*
         * FrameBuffer
         */
        allocator_ =
            std::make_unique<FrameBufferAllocator>(camera_);

        ret = allocator_->allocate(stream_);

        if (ret < 0) {
            std::cerr << "FrameBuffer allocation failed: "
                      << ret << std::endl;

            cleanup();
            return ret;
        }

        const auto &buffers =
            allocator_->buffers(stream_);

        std::cout << "Buffers: "
                  << buffers.size()
                  << std::endl;

        /*
         * mmap 每個 buffer
         */
        for (const auto &buffer : buffers) {

            std::vector<MappedPlane> mapped;

            for (const auto &plane : buffer->planes()) {

                void *data = mmap(
                    nullptr,
                    plane.length,
                    PROT_READ,
                    MAP_SHARED,
                    plane.fd.get(),
                    plane.offset
                );

                if (data == MAP_FAILED) {

                    std::cerr << "mmap failed"
                              << std::endl;

                    cleanup();
                    return -1;
                }

                mapped.push_back({
                    data,
                    plane.length
                });
            }

            mappedBuffers_.push_back(
                std::move(mapped)
            );
        }

        /*
         * 重要：
         * libcamera 0.5.2 不接受 lambda。
         *
         * 使用 class member function。
         */
        camera_->requestCompleted.connect(
            this,
            &CameraPreview::requestComplete
        );

        /*
         * 建立 Requests
         */
        for (const auto &buffer : buffers) {

            std::unique_ptr<Request> request =
                camera_->createRequest();

            if (!request) {

                std::cerr
                    << "Failed to create request"
                    << std::endl;

                cleanup();
                return -1;
            }

            ret = request->addBuffer(
                stream_,
                buffer.get()
            );

            if (ret < 0) {

                std::cerr
                    << "Failed to add buffer"
                    << std::endl;

                cleanup();
                return ret;
            }

            requests_.push_back(
                std::move(request)
            );
        }

        /*
         * 啟動 camera
         */
        ret = camera_->start();

        if (ret) {

            std::cerr
                << "Camera start failed: "
                << ret
                << std::endl;

            cleanup();
            return ret;
        }

        /*
         * Queue 所有 request
         */
        for (auto &request : requests_) {

            ret = camera_->queueRequest(
                request.get()
            );

            if (ret < 0) {

                std::cerr
                    << "Failed to queue request: "
                    << ret
                    << std::endl;

                running_ = false;

                camera_->stop();

                cleanup();

                return ret;
            }
        }

        std::cout << std::endl;
        std::cout
            << "============================"
            << std::endl;

        std::cout
            << " IMX219 C++ Preview"
            << std::endl;

        std::cout
            << " 640x480"
            << std::endl;

        std::cout
            << " Press Q to quit"
            << std::endl;

        std::cout
            << "============================"
            << std::endl;

        /*
         * OpenCV 視窗
         */
        cv::namedWindow(
            "Raspberry Pi Camera",
            cv::WINDOW_NORMAL
        );

        cv::resizeWindow(
            "Raspberry Pi Camera",
            640,
            480
        );

        int frameCount = 0;

        double fps = 0;

        auto lastTime =
            std::chrono::steady_clock::now();

        /*
         * 主迴圈
         */
        while (running_) {

            cv::Mat frame;

            {
                std::unique_lock<std::mutex> lock(
                    mutex_
                );

                condition_.wait(
                    lock,
                    [this]() {
                        return frameReady_
                            || !running_;
                    }
                );

                if (!running_)
                    break;

                frame = latestFrame_.clone();

                frameReady_ = false;
            }

            if (frame.empty())
                continue;

            // YOLOv8 inference using ONNX Runtime
            std::vector<Detection> detections;
            try {
                detections = detector.detect(frame);
            } catch (const std::exception& e) {
                std::cerr << "[DEBUG] Inference failed: "
                          << e.what() << std::endl;
                running_ = false;
                break;
            }

            for (const auto& detection : detections) {
                cv::rectangle(
                    frame,
                    detection.box,
                    cv::Scalar(0, 255, 0),
                    2
                );

                std::string label = "class " +
                    std::to_string(detection.classId);

                const auto& names = detector.classNames();
                if (detection.classId >= 0 &&
                    detection.classId < static_cast<int>(names.size())) {
                    label = names[detection.classId];
                }

                label += " " + std::to_string(
                    static_cast<int>(detection.confidence * 100)
                ) + "%";

                const int textY = std::max(20, detection.box.y - 8);

                cv::putText(
                    frame,
                    label,
                    cv::Point(detection.box.x, textY),
                    cv::FONT_HERSHEY_SIMPLEX,
                    0.5,
                    cv::Scalar(0, 255, 0),
                    2
                );
            }

            frameCount++;

            auto now =
                std::chrono::steady_clock::now();

            double elapsed =
                std::chrono::duration<double>(
                    now - lastTime
                ).count();

            if (elapsed >= 1.0) {

                fps =
                    frameCount / elapsed;

                frameCount = 0;

                lastTime = now;
            }

            cv::putText(
                frame,
                "FPS: " +
                    std::to_string(
                        static_cast<int>(fps)
                    ),
                cv::Point(10, 30),
                cv::FONT_HERSHEY_SIMPLEX,
                0.8,
                cv::Scalar(0, 255, 0),
                2
            );

            cv::imshow(
                "Raspberry Pi Camera",
                frame
            );

            int key = cv::waitKey(1);

            if (key == 'q' ||
                key == 'Q') {

                running_ = false;
                break;
            }
        }

        running_ = false;

        /*
         * 停止 camera
         */
        camera_->stop();

        cv::destroyAllWindows();

        cleanup();

        return 0;
    }

private:

    struct MappedPlane
    {
        void *data;
        size_t length;
    };

    /*
     * 這就是 libcamera Signal 要求的
     * member function。
     */
    void requestComplete(Request *request)
    {
        if (!running_)
            return;

        if (request->status() ==
            Request::RequestCancelled) {

            return;
        }

        const auto &buffers =
            request->buffers();

        auto it =
            buffers.find(stream_);

        if (it == buffers.end())
            return;

        FrameBuffer *buffer =
            it->second;

        /*
         * 找 buffer index
         */
        const auto &allocatedBuffers =
            allocator_->buffers(stream_);

        size_t index = 0;

        for (size_t i = 0;
             i < allocatedBuffers.size();
             ++i) {

            if (allocatedBuffers[i].get()
                == buffer) {

                index = i;
                break;
            }
        }

        if (index >= mappedBuffers_.size())
            return;

        if (mappedBuffers_[index].empty())
            return;

        void *data =
            mappedBuffers_[index][0].data;

        /*
         * RGB888 → OpenCV
         */
        cv::Mat rgb(
            480,
            640,
            CV_8UC3,
            data,
            streamConfig_->stride
        );

        cv::Mat bgr;

        cv::cvtColor(
            rgb,
            bgr,
            cv::COLOR_RGB2BGR
        );

        /*
         * 複製到自己的 buffer
         */
        {
            std::lock_guard<std::mutex> lock(
                mutex_
            );

            latestFrame_ =
                bgr.clone();

            frameReady_ = true;
        }

        condition_.notify_one();

          /*
 * Request 已經完成，必須先重設狀態
 * 才能再次 queue。
 */
if (running_) {
    request->reuse(Request::ReuseBuffers);

    int ret = camera_->queueRequest(request);

    if (ret < 0) {
        std::cerr
            << "Failed to requeue request: "
            << ret
            << std::endl;
    }
}        


    }

    void cleanup()
    {
        /*
         * unmap
         */
        for (auto &buffer :
             mappedBuffers_) {

            for (auto &plane :
                 buffer) {

                if (plane.data) {

                    munmap(
                        plane.data,
                        plane.length
                    );
                }
            }
        }

        mappedBuffers_.clear();

        /*
         * 注意：
         *
         * FrameBufferAllocator
         * 沒有 release()。
         *
         * unique_ptr destructor
         * 會自動清理。
         */
        allocator_.reset();

        requests_.clear();

        if (camera_) {

            camera_->release();

            camera_.reset();
        }

        cameraManager_.stop();
    }

private:

    CameraManager cameraManager_;

    std::shared_ptr<Camera> camera_;

    std::unique_ptr<CameraConfiguration>
        config_;

    StreamConfiguration *
        streamConfig_ = nullptr;

    Stream *
        stream_ = nullptr;

    std::unique_ptr<FrameBufferAllocator>
        allocator_;

    std::vector<std::unique_ptr<Request>>
        requests_;

    std::vector<
        std::vector<MappedPlane>
    >
        mappedBuffers_;

    cv::Mat latestFrame_;

    std::mutex mutex_;

    std::condition_variable
        condition_;

    bool running_;

    bool frameReady_;
};


int main()
{
    try {
        CameraPreview preview;
        return preview.run();
    } catch (const Ort::Exception& e) {
        std::cerr << "ONNX Runtime error: "
                  << e.what() << std::endl;
        return 1;
    } catch (const std::exception& e) {
        std::cerr << "Application error: "
                  << e.what() << std::endl;
        return 1;
    }
}
