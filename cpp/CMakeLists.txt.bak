cmake_minimum_required(VERSION 3.16)
project(yolo_ort_arm64 CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release)
endif()
set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG")

find_package(OpenCV REQUIRED)
find_package(PkgConfig REQUIRED)
pkg_check_modules(LIBCAMERA REQUIRED libcamera)

set(ONNXRUNTIME_ROOT "$ENV{HOME}/ai_camera/onnxruntime-linux-aarch64-1.17.0"
    CACHE PATH "ONNX Runtime root (aarch64)")

include_directories(
    ${CMAKE_SOURCE_DIR}
    ${ONNXRUNTIME_ROOT}/include
    ${LIBCAMERA_INCLUDE_DIRS}
)
link_directories(
    ${ONNXRUNTIME_ROOT}/lib
    ${LIBCAMERA_LIBRARY_DIRS}
)

add_executable(yolo_ort
    main.cpp
    detector.cpp
    camera.cpp
    preview.cpp
)

target_link_libraries(yolo_ort
    ${OpenCV_LIBS}
    onnxruntime
    ${LIBCAMERA_LIBRARIES}
)

set_target_properties(yolo_ort PROPERTIES
    BUILD_RPATH   "${ONNXRUNTIME_ROOT}/lib"
    INSTALL_RPATH "${ONNXRUNTIME_ROOT}/lib"
)
